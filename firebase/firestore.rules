rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath(sid) { return /databases/$(database)/documents/schools/$(sid)/members/$(request.auth.uid); }
    function active(sid) {
      return signedIn() && exists(memberPath(sid))
        && get(memberPath(sid)).data.schoolId == sid
        && get(memberPath(sid)).data.status == 'active';
    }
    function teacher(sid) { return active(sid) && get(memberPath(sid)).data.role in ['teacher','owner']; }
    function ownStudent(sid,studentId) { return active(sid) && get(memberPath(sid)).data.role == 'student' && get(memberPath(sid)).data.studentId == studentId; }
    function activeStudent(sid) { return active(sid) && get(memberPath(sid)).data.role == 'student'; }
    function callerStudentId(sid) { return get(memberPath(sid)).data.studentId; }
    function studentShape(sid) {
      let d = request.resource.data;
      return d.keys().hasAll(['schoolId','name','grade','className','citizenCode','schoolYear','status','schemaVersion','createdAt','updatedAt'])
        && d.keys().hasOnly(['schoolId','name','grade','className','citizenCode','schoolYear','status','schemaVersion','createdAt','updatedAt'])
        && d.schoolId == sid && d.schemaVersion == 1
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.grade is int && d.grade >= 1 && d.grade <= 6
        && (d.className == null || (d.className is string && d.className.size() <= 20))
        && d.citizenCode is string && d.citizenCode.size() > 0 && d.citizenCode.size() <= 50
        && d.schoolYear is int && d.schoolYear >= 2020 && d.schoolYear <= 2100
        && d.status in ['active','graduated','transferred']
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /userSchools/{uid}/links/{sid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // trusted provisioning only; never used as authorization
    }
    match /schools/{sid} {
      allow get: if active(sid);
      allow list, create, delete: if false;
      allow update: if teacher(sid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schoolName','communityName','currencyName','currencySymbol','incomeTaxRateBp','updatedAt'])
        && request.resource.data.schoolName is string && request.resource.data.schoolName.size() > 0 && request.resource.data.schoolName.size() <= 80
        && request.resource.data.communityName is string && request.resource.data.communityName.size() > 0 && request.resource.data.communityName.size() <= 80
        && request.resource.data.currencyName is string && request.resource.data.currencyName.size() > 0 && request.resource.data.currencyName.size() <= 20
        && request.resource.data.currencySymbol is string && request.resource.data.currencySymbol.size() <= 10
        // Nullable: existing schools predate this field (D-56 pattern of D-33's lastJournalId==null).
        && (request.resource.data.incomeTaxRateBp == null || (request.resource.data.incomeTaxRateBp is int && request.resource.data.incomeTaxRateBp >= 0 && request.resource.data.incomeTaxRateBp <= 2000))
        && request.resource.data.updatedAt == request.time;
      match /members/{uid} {
        allow get: if active(sid) && (request.auth.uid == uid || teacher(sid));
        allow list: if teacher(sid);
        allow write: if false;
      }
      match /students/{studentId} {
        allow get: if teacher(sid) || ownStudent(sid,studentId);
        allow list: if teacher(sid) && request.query.limit != null && request.query.limit <= 100;
        allow create: if teacher(sid) && studentShape(sid)
          && request.resource.data.createdAt == request.time && request.resource.data.status == 'active';
        allow update: if teacher(sid) && studentShape(sid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','grade','className','schoolYear','status','updatedAt']);
        allow delete: if false;
      }
      match /importBatches/{batchId} {
        allow read: if teacher(sid);
        allow create: if teacher(sid)
          && request.resource.data.keys().hasOnly(['schoolId','actorUid','acceptedCount','status','createdAt','schemaVersion'])
          && request.resource.data.schoolId == sid && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.schemaVersion == 1 && request.resource.data.status == 'completed'
          && request.resource.data.acceptedCount is int && request.resource.data.acceptedCount > 0 && request.resource.data.acceptedCount <= 50
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      function bounded() { return request.query.limit != null && request.query.limit <= 100; }
      // Vote tallying must read every vote, not a page of them, so it gets its own higher cap
      // rather than raising the general list ceiling everywhere else.
      function boundedVotes() { return request.query.limit != null && request.query.limit <= 500; }
      function pairOwner(id) {
        return active(sid) && get(memberPath(sid)).data.role == 'student'
          && id.matches('^[A-Za-z0-9_-]+~' + get(memberPath(sid)).data.studentId + '$');
      }
      function jobPath(id) { return /databases/$(database)/documents/schools/$(sid)/jobs/$(id); }
      function assignmentPath(id) { return /databases/$(database)/documents/schools/$(sid)/jobAssignments/$(id); }
      function jobShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','departmentId','name','description','core','status','recommendedGrades','icon','salaryMinor','schemaVersion','createdAt','updatedAt'])
          && d.keys().hasOnly(['schoolId','departmentId','name','description','core','status','recommendedGrades','icon','salaryMinor','schemaVersion','createdAt','updatedAt'])
          && d.schoolId==sid && d.schemaVersion==1 && d.core is bool
          && d.departmentId in ['economy','media','life','culture']
          && d.name is string && d.name.size()>0 && d.name.size()<=60
          && d.description is string && d.description.size()>0 && d.description.size()<=1000
          && d.status in ['preparing','recruiting','active','paused','closed']
          && d.recommendedGrades is list && d.recommendedGrades.size()>0 && d.recommendedGrades.size()<=6
          && d.recommendedGrades.toSet().size()==d.recommendedGrades.size()
          && d.recommendedGrades.hasOnly([1,2,3,4,5,6])
          && d.icon in ['banker','tax_accounting','store_manager','cafe_worker','real_estate','business_manager','journalist','photographer','writer','webtoon_artist','painter','digital_manager','dj','library_manager','environment_manager','plant_manager','safety_manager','rules_manager','milk_delivery','parcel_delivery','school_notice','noticeboard_manager','event_planner','music','singer','dancer','board_game','culture_play']
          && d.salaryMinor is int && d.salaryMinor>=0 && d.salaryMinor<=1000000
          && d.createdAt is timestamp && d.updatedAt==request.time;
      }
      match /jobs/{jobId} {
        allow get: if active(sid);
        allow list: if active(sid) && bounded();
        allow create: if teacher(sid) && jobId.matches('^[A-Za-z0-9_-]{1,100}$') && jobShape() && request.resource.data.createdAt==request.time;
        allow update: if teacher(sid) && jobShape() && resource.data.status!='closed'
          && (!resource.data.core || request.resource.data.core)
          && request.resource.data.createdAt==resource.data.createdAt;
        allow delete: if false;
      }
      match /jobApplications/{applicationId} {
        allow get: if teacher(sid) || pairOwner(applicationId);
        allow list: if bounded() && (teacher(sid) || ownStudent(sid,resource.data.studentId));
        allow create: if ownStudent(sid,request.resource.data.studentId)
          && request.resource.data.keys().hasAll(['schoolId','jobId','studentId','reason','status','reviewNote','reviewerUid','reviewedAt','submittedAt','schemaVersion'])
          && request.resource.data.keys().hasOnly(['schoolId','jobId','studentId','reason','status','reviewNote','reviewerUid','reviewedAt','submittedAt','schemaVersion'])
          && request.resource.data.schoolId==sid && request.resource.data.schemaVersion==1
          && request.resource.data.jobId.matches('^[A-Za-z0-9_-]{1,100}$')
          && request.resource.data.studentId.matches('^[A-Za-z0-9_-]{1,100}$')
          && applicationId==request.resource.data.jobId+'~'+request.resource.data.studentId
          && get(jobPath(request.resource.data.jobId)).data.status=='recruiting'
          && get(/databases/$(database)/documents/schools/$(sid)/students/$(request.resource.data.studentId)).data.status=='active'
          && (!exists(assignmentPath(applicationId)) || get(assignmentPath(applicationId)).data.status!='active')
          && request.resource.data.reason is string && request.resource.data.reason.size()>0 && request.resource.data.reason.size()<=500
          && request.resource.data.status=='submitted' && request.resource.data.reviewNote==''
          && request.resource.data.reviewerUid==null && request.resource.data.reviewedAt==null
          && request.resource.data.submittedAt==request.time;
        allow update: if teacher(sid) && resource.data.status=='submitted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewNote','reviewerUid','reviewedAt'])
          && request.resource.data.reviewNote is string && request.resource.data.reviewNote.size()<=500
          && request.resource.data.reviewerUid==request.auth.uid && request.resource.data.reviewedAt==request.time
          && ((request.resource.data.status=='rejected' && request.resource.data.reviewNote.size()>0)
            || (request.resource.data.status=='approved'
              && get(jobPath(resource.data.jobId)).data.status in ['recruiting','active']
              && getAfter(assignmentPath(applicationId)).data.status=='active'
              && getAfter(assignmentPath(applicationId)).data.studentId==resource.data.studentId
              && getAfter(assignmentPath(applicationId)).data.jobId==resource.data.jobId));
        allow delete: if false;
      }
      function assignmentShape(id) {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','jobId','studentId','status','schemaVersion','startAt','endAt','assignedBy','updatedAt'])
          && d.keys().hasOnly(['schoolId','jobId','studentId','status','schemaVersion','startAt','endAt','assignedBy','updatedAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.jobId.matches('^[A-Za-z0-9_-]{1,100}$') && d.studentId.matches('^[A-Za-z0-9_-]{1,100}$')
          && id==d.jobId+'~'+d.studentId && d.updatedAt==request.time;
      }
      function newAssignment(id) {
        let d=request.resource.data;
        return assignmentShape(id) && d.status=='active' && d.startAt==request.time && d.endAt==null
          && d.assignedBy==request.auth.uid && get(jobPath(d.jobId)).data.status in ['recruiting','active']
          && get(/databases/$(database)/documents/schools/$(sid)/students/$(d.studentId)).data.status=='active';
      }
      match /jobAssignments/{assignmentId} {
        allow get: if teacher(sid) || pairOwner(assignmentId);
        allow list: if bounded() && (teacher(sid) || ownStudent(sid,resource.data.studentId));
        allow create: if teacher(sid) && newAssignment(assignmentId);
        allow update: if teacher(sid) && assignmentShape(assignmentId)
          && request.resource.data.jobId==resource.data.jobId && request.resource.data.studentId==resource.data.studentId
          && ((resource.data.status=='ended' && newAssignment(assignmentId))
            || (resource.data.status=='active' && request.resource.data.status=='ended' && request.resource.data.endAt==request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endAt','updatedAt'])));
        allow delete: if false;
      }
      function taskTemplatePath(id) { return /databases/$(database)/documents/schools/$(sid)/taskTemplates/$(id); }
      function templateShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','jobId','title','instructions','verificationKind','status','schemaVersion','createdAt','updatedAt'])
          && d.keys().hasOnly(['schoolId','jobId','title','instructions','verificationKind','status','schemaVersion','createdAt','updatedAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.jobId.matches('^[A-Za-z0-9_-]{1,100}$')
          && d.title is string && d.title.size()>0 && d.title.size()<=60
          && d.instructions is string && d.instructions.size()>0 && d.instructions.size()<=1000
          && d.verificationKind in ['artifact','photo','system']
          && d.status in ['active','archived']
          && d.createdAt is timestamp && d.updatedAt==request.time;
      }
      match /taskTemplates/{templateId} {
        allow get: if active(sid);
        allow list: if active(sid) && bounded();
        allow create: if teacher(sid) && templateId.matches('^[A-Za-z0-9_-]{1,100}$') && templateShape()
          && request.resource.data.createdAt==request.time && exists(jobPath(request.resource.data.jobId));
        allow update: if teacher(sid) && templateShape()
          && request.resource.data.jobId==resource.data.jobId && request.resource.data.createdAt==resource.data.createdAt;
        allow delete: if false;
      }
      function taskShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','templateId','jobId','assigneeStudentId','verificationKind','status','attempt','submissionText','reviewNote','reviewerUid','schemaVersion','createdAt','updatedAt'])
          && d.keys().hasOnly(['schoolId','templateId','jobId','assigneeStudentId','verificationKind','status','attempt','submissionText','reviewNote','reviewerUid','schemaVersion','createdAt','updatedAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.templateId.matches('^[A-Za-z0-9_-]{1,100}$') && d.jobId.matches('^[A-Za-z0-9_-]{1,100}$') && d.assigneeStudentId.matches('^[A-Za-z0-9_-]{1,100}$')
          && d.verificationKind in ['artifact','photo','system']
          && d.status in ['assigned','submitted','approved','revision_requested']
          && d.attempt is int && d.attempt>=0
          && d.submissionText is string && d.submissionText.size()<=2000
          && d.reviewNote is string && d.reviewNote.size()<=500
          && (d.reviewerUid==null || d.reviewerUid is string)
          && d.createdAt is timestamp && d.updatedAt==request.time;
      }
      match /tasks/{taskId} {
        allow get: if teacher(sid) || ownStudent(sid,resource.data.assigneeStudentId);
        allow list: if bounded() && (teacher(sid) || ownStudent(sid,resource.data.assigneeStudentId));
        allow create: if teacher(sid) && taskId==request.resource.data.templateId+'~'+request.resource.data.assigneeStudentId
          && taskShape()
          && request.resource.data.status=='assigned' && request.resource.data.attempt==0
          && request.resource.data.submissionText=='' && request.resource.data.reviewNote=='' && request.resource.data.reviewerUid==null
          && request.resource.data.createdAt==request.time
          && get(taskTemplatePath(request.resource.data.templateId)).data.status=='active'
          && get(taskTemplatePath(request.resource.data.templateId)).data.jobId==request.resource.data.jobId
          && get(assignmentPath(request.resource.data.jobId+'~'+request.resource.data.assigneeStudentId)).data.status=='active';
        allow update: if taskShape()
          && request.resource.data.templateId==resource.data.templateId
          && request.resource.data.jobId==resource.data.jobId
          && request.resource.data.assigneeStudentId==resource.data.assigneeStudentId
          && request.resource.data.verificationKind==resource.data.verificationKind
          && (
            (ownStudent(sid,resource.data.assigneeStudentId)
              && resource.data.status in ['assigned','revision_requested']
              && request.resource.data.status=='submitted'
              && request.resource.data.attempt==resource.data.attempt+1
              && request.resource.data.submissionText.size()>0
              && request.resource.data.reviewNote=='' && request.resource.data.reviewerUid==null)
            ||
            (teacher(sid)
              && resource.data.status=='submitted'
              && request.resource.data.status in ['approved','revision_requested']
              && request.resource.data.attempt==resource.data.attempt
              && request.resource.data.submissionText==resource.data.submissionText
              && request.resource.data.reviewerUid==request.auth.uid
              && (request.resource.data.status=='approved' || request.resource.data.reviewNote.size()>0))
            ||
            (teacher(sid)
              && resource.data.status=='approved'
              && request.resource.data.status=='assigned'
              && request.resource.data.attempt==resource.data.attempt
              && request.resource.data.submissionText=='' && request.resource.data.reviewNote=='' && request.resource.data.reviewerUid==null
              && get(taskTemplatePath(resource.data.templateId)).data.status=='active'
              && get(assignmentPath(resource.data.jobId+'~'+resource.data.assigneeStudentId)).data.status=='active')
          );
        allow delete: if false;
      }
      function taskPath(id) { return /databases/$(database)/documents/schools/$(sid)/tasks/$(id); }
      function evidenceShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','studentId','taskId','mimeType','payloadBase64','expiresAt','createdAt'])
          && d.keys().hasOnly(['schoolId','studentId','taskId','mimeType','payloadBase64','expiresAt','createdAt'])
          && d.schoolId==sid
          && d.studentId.matches('^[A-Za-z0-9_-]{1,100}$') && d.taskId.matches('^[A-Za-z0-9_~-]{1,100}$')
          && d.mimeType=='image/jpeg'
          && d.payloadBase64 is string && d.payloadBase64.size()>0 && d.payloadBase64.size()<=90000
          && d.expiresAt is timestamp && d.expiresAt>request.time
          && d.createdAt==request.time;
      }
      // One temporary photo per task (doc id == taskId): a fresh submission always creates it
      // (the previous one is deleted at review time, approved or rejected — see taskRepository
      // .review()), never updates it. Reads past expiresAt are blocked by rules immediately;
      // physical deletion of expired-but-unreviewed evidence happens lazily on a teacher's next
      // visit (purgeExpiredEvidence) since Spark has no scheduled Functions/TTL.
      match /evidence/{evidenceId} {
        // resource != null guarded first: unlike accounts (D-20), evidence ownership can't be
        // encoded in the path alone, so a deleted/never-existing doc must fail as a clean
        // denial here rather than erroring on a null resource.
        allow get: if resource!=null && request.time<resource.data.expiresAt && (teacher(sid) || ownStudent(sid,resource.data.studentId));
        allow list: if teacher(sid) && bounded();
        allow create: if ownStudent(sid,request.resource.data.studentId) && evidenceId==request.resource.data.taskId
          && evidenceShape()
          && get(taskPath(evidenceId)).data.assigneeStudentId==request.resource.data.studentId
          && get(taskPath(evidenceId)).data.verificationKind=='photo'
          && get(taskPath(evidenceId)).data.status in ['assigned','revision_requested'];
        allow update: if false;
        allow delete: if teacher(sid) || ownStudent(sid,resource.data.studentId);
      }
      function journalPath(id) { return /databases/$(database)/documents/schools/$(sid)/journals/$(id); }
      function accountPath(id) { return /databases/$(database)/documents/schools/$(sid)/accounts/$(id); }
      function accountShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','ownerType','ownerId','balanceMinor','version','lastJournalId','status','schemaVersion','createdAt','updatedAt'])
          && d.keys().hasOnly(['schoolId','ownerType','ownerId','balanceMinor','version','lastJournalId','status','schemaVersion','createdAt','updatedAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.ownerType in ['student','school','business']
          && d.ownerId is string && d.ownerId.size()>0 && d.ownerId.size()<=100
          && d.balanceMinor is int
          && d.version is int && d.version>=0
          && (d.lastJournalId==null || d.lastJournalId is string)
          && d.status=='active'
          && d.createdAt is timestamp && d.updatedAt==request.time;
      }
      // A journal only ever justifies a balance change to the actor who is allowed to post
      // that journal type: teacher for SALARY (settlement), the buyer themself for PURCHASE
      // (instant, fully rule-validated self-service — see purchaseJournalShape below).
      function journalActorOk(j) {
        return (j.type=='SALARY' && teacher(sid))
          || (j.type=='PURCHASE' && activeStudent(sid) && callerStudentId(sid)==j.buyerStudentId)
          || (j.type=='SAVINGS_DEPOSIT' && activeStudent(sid) && callerStudentId(sid)==j.studentId)
          || (j.type=='INTEREST' && teacher(sid))
          || (j.type=='LOAN' && teacher(sid))
          || (j.type=='LOAN_REPAYMENT' && activeStudent(sid) && callerStudentId(sid)==j.studentId)
          || (j.type=='INCOME_TAX' && teacher(sid));
      }
      // Money never moves without an immutable journal: every account write must reference
      // (via lastJournalId + getAfter) a journal created in the very same transaction whose
      // debit/credit side and amount justify exactly this balance change.
      match /accounts/{accountId} {
        function creditedOnCreate() {
          let j=getAfter(journalPath(request.resource.data.lastJournalId)).data;
          return j.creditAccountId==accountId && request.resource.data.balanceMinor==j.amountMinor;
        }
        function creditedHere() {
          let j=getAfter(journalPath(request.resource.data.lastJournalId)).data;
          return j.creditAccountId==accountId && request.resource.data.balanceMinor==resource.data.balanceMinor+j.amountMinor && journalActorOk(j);
        }
        function debitedHere() {
          let j=getAfter(journalPath(request.resource.data.lastJournalId)).data;
          return j.debitAccountId==accountId && request.resource.data.balanceMinor==resource.data.balanceMinor-j.amountMinor && journalActorOk(j);
        }
        // accountId equals the owning student's studentId by construction (see create rule
        // below), so ownership is checked against the path itself rather than resource.data —
        // a resource.data check would error (and thus deny) when the account doc doesn't exist
        // yet, e.g. a student who has never been paid trying to read their own empty account.
        // Business accounts are also readable by any active member (not just the owner/teacher):
        // a buyer's purchase transaction must read the seller's current balance to credit it,
        // and a store till isn't the sensitive peer-to-peer information §6 asks to keep private.
        // The system-issuer account is the same kind of non-sensitive shared information (the
        // school's total printed-minus-collected balance, not any individual's data) — a student
        // depositing into savings or repaying a loan must read its current balance in the same
        // transaction to credit/debit it correctly (see openSavings/repay in the data layer).
        allow get: if teacher(sid) || ownStudent(sid,accountId) || exists(businessPath(accountId)) || accountId=='system-issuer' || accountId=='community-fund';
        allow list: if teacher(sid) && bounded();
        // Only ever created by a teacher: the system issuer (once), a student account (lazily,
        // on first salary payment), or a business account (alongside the business itself).
        allow create: if teacher(sid) && accountShape()
          && request.resource.data.version==0 && request.resource.data.createdAt==request.time
          && (
            (accountId=='system-issuer' && request.resource.data.ownerType=='school' && request.resource.data.ownerId=='system-issuer'
              && request.resource.data.balanceMinor==0 && request.resource.data.lastJournalId==null)
            ||
            (accountId=='community-fund' && request.resource.data.ownerType=='school' && request.resource.data.ownerId=='community-fund'
              && request.resource.data.balanceMinor==0 && request.resource.data.lastJournalId==null)
            ||
            (request.resource.data.ownerType=='student' && accountId==request.resource.data.ownerId
              && get(/databases/$(database)/documents/schools/$(sid)/students/$(accountId)).data.status=='active'
              && request.resource.data.lastJournalId!=null && creditedOnCreate())
            ||
            // getAfter, not exists: the business doc is created in this very same transaction
            // (see createBusiness), so its pre-transaction existence is not yet true.
            (request.resource.data.ownerType=='business' && accountId==request.resource.data.ownerId
              && getAfter(businessPath(accountId)).data.schoolId==sid
              && request.resource.data.balanceMinor==0 && request.resource.data.lastJournalId==null)
          );
        // No role wildcard here: a teacher may only move the SALARY side, a student only their
        // own PURCHASE side, enforced entirely inside creditedHere()/debitedHere() above.
        allow update: if accountShape()
          && request.resource.data.ownerType==resource.data.ownerType && request.resource.data.ownerId==resource.data.ownerId
          && request.resource.data.version==resource.data.version+1
          && request.resource.data.createdAt==resource.data.createdAt
          && request.resource.data.lastJournalId!=null && request.resource.data.lastJournalId!=resource.data.lastJournalId
          && (request.resource.data.ownerType=='school' || request.resource.data.balanceMinor>=0)
          && (creditedHere() || debitedHere());
        allow delete: if false;
        match /entries/{entryId} {
          allow get: if teacher(sid) || ownStudent(sid,accountId) || ownBusiness(accountId);
          allow list: if bounded() && (teacher(sid) || ownStudent(sid,accountId) || ownBusiness(accountId));
          allow create: if request.resource.data.keys().hasAll(['schoolId','journalId','type','deltaMinor','balanceAfterMinor','label','postedAt'])
            && request.resource.data.keys().hasOnly(['schoolId','journalId','type','deltaMinor','balanceAfterMinor','label','postedAt'])
            && request.resource.data.schoolId==sid && request.resource.data.journalId==entryId && request.resource.data.type in ['SALARY','PURCHASE','SAVINGS_DEPOSIT','INTEREST','LOAN','LOAN_REPAYMENT','INCOME_TAX']
            && request.resource.data.label is string && request.resource.data.label.size()<=60
            && request.resource.data.postedAt==request.time
            && request.resource.data.balanceAfterMinor==getAfter(/databases/$(database)/documents/schools/$(sid)/accounts/$(accountId)).data.balanceMinor
            && journalActorOk(getAfter(journalPath(entryId)).data)
            && (
              (getAfter(journalPath(entryId)).data.creditAccountId==accountId && request.resource.data.deltaMinor==getAfter(journalPath(entryId)).data.amountMinor)
              ||
              (getAfter(journalPath(entryId)).data.debitAccountId==accountId && request.resource.data.deltaMinor==-getAfter(journalPath(entryId)).data.amountMinor)
            );
          allow update, delete: if false;
        }
      }
      function businessPath(id) { return /databases/$(database)/documents/schools/$(sid)/businesses/$(id); }
      function productPath(id) { return /databases/$(database)/documents/schools/$(sid)/products/$(id); }
      // The student assigned as a business's owner (§25) may manage its own products and see its
      // own sales history — this is authorization, so it checks the trusted businesses/{id} doc's
      // ownerStudentId, never a client-supplied value.
      function ownBusiness(businessId) { return activeStudent(sid) && get(businessPath(businessId)).data.ownerStudentId==callerStudentId(sid); }
      function businessShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','name','ownerStudentId','status','schemaVersion','createdAt','updatedAt'])
          && d.keys().hasOnly(['schoolId','name','ownerStudentId','status','schemaVersion','createdAt','updatedAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.name is string && d.name.size()>0 && d.name.size()<=60
          && d.ownerStudentId.matches('^[A-Za-z0-9_-]{1,100}$')
          && d.status in ['active','closed']
          && d.createdAt is timestamp && d.updatedAt==request.time;
      }
      // Businesses are teacher-created for now (no citizen proposal pipeline yet — see D-22);
      // a business account is created in the same transaction, mirroring the issuer bootstrap.
      match /businesses/{businessId} {
        allow get: if active(sid);
        allow list: if active(sid) && bounded();
        allow create: if teacher(sid) && businessId.matches('^[A-Za-z0-9_-]{1,100}$') && businessShape()
          && request.resource.data.createdAt==request.time
          && get(/databases/$(database)/documents/schools/$(sid)/students/$(request.resource.data.ownerStudentId)).data.status=='active';
        allow update: if teacher(sid) && businessShape()
          && request.resource.data.ownerStudentId==resource.data.ownerStudentId && request.resource.data.createdAt==resource.data.createdAt;
        allow delete: if false;
      }
      function productShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','businessId','name','priceMinor','stock','lastJournalId','status','schemaVersion','createdAt','updatedAt'])
          && d.keys().hasOnly(['schoolId','businessId','name','priceMinor','stock','lastJournalId','status','schemaVersion','createdAt','updatedAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.businessId.matches('^[A-Za-z0-9_-]{1,100}$')
          && d.name is string && d.name.size()>0 && d.name.size()<=60
          && d.priceMinor is int && d.priceMinor>0 && d.priceMinor<=100000
          && d.stock is int && d.stock>=0 && d.stock<=100000
          && (d.lastJournalId==null || d.lastJournalId is string)
          && d.status in ['active','paused']
          && d.createdAt is timestamp && d.updatedAt==request.time;
      }
      match /products/{productId} {
        allow get: if active(sid);
        allow list: if active(sid) && bounded();
        allow create: if (teacher(sid) || ownBusiness(request.resource.data.businessId)) && productShape() && request.resource.data.lastJournalId==null
          && request.resource.data.createdAt==request.time && exists(businessPath(request.resource.data.businessId));
        // A teacher, or the student who owns this product's business (§25), may edit
        // name/price/stock/status directly (lastJournalId untouched). Any other student may only
        // decrement stock by exactly 1, tied to a PURCHASE journal created in the same
        // transaction that names this product — never price, name, or status.
        allow update: if productShape() && request.resource.data.businessId==resource.data.businessId && request.resource.data.createdAt==resource.data.createdAt
          && (
            ((teacher(sid) || ownBusiness(resource.data.businessId)) && request.resource.data.lastJournalId==resource.data.lastJournalId)
            ||
            (activeStudent(sid)
              && request.resource.data.lastJournalId!=null && request.resource.data.lastJournalId!=resource.data.lastJournalId
              && request.resource.data.name==resource.data.name && request.resource.data.priceMinor==resource.data.priceMinor
              && request.resource.data.status==resource.data.status
              && request.resource.data.stock==resource.data.stock-1
              && getAfter(journalPath(request.resource.data.lastJournalId)).data.type=='PURCHASE'
              && getAfter(journalPath(request.resource.data.lastJournalId)).data.productId==productId
              && callerStudentId(sid)==getAfter(journalPath(request.resource.data.lastJournalId)).data.buyerStudentId)
          );
        allow delete: if false;
      }
      function financialProductPath(id) { return /databases/$(database)/documents/schools/$(sid)/financialProducts/$(id); }
      function financialProductShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','kind','name','rateBpsMonthly','minMonths','maxMonths','minMinor','maxMinor','status','schemaVersion','createdAt','updatedAt'])
          && d.keys().hasOnly(['schoolId','kind','name','rateBpsMonthly','minMonths','maxMonths','minMinor','maxMinor','status','schemaVersion','createdAt','updatedAt'])
          && d.schoolId==sid && d.schemaVersion==1 && d.kind in ['savings','loan']
          && d.name is string && d.name.size()>0 && d.name.size()<=60
          && d.rateBpsMonthly is int && d.rateBpsMonthly>=0 && d.rateBpsMonthly<=10000
          && d.minMonths is int && d.maxMonths is int && d.minMonths>=1 && d.maxMonths<=120 && d.minMonths<=d.maxMonths
          && d.minMinor is int && d.maxMinor is int && d.minMinor>=0 && d.maxMinor<=1000000000 && d.minMinor<=d.maxMinor
          && d.status in ['active','closed']
          && d.createdAt is timestamp && d.updatedAt==request.time;
      }
      // Savings products are teacher-configured (§17); no hard delete, only status:'closed' (D-11 pattern).
      match /financialProducts/{productId} {
        allow get: if active(sid);
        allow list: if active(sid) && bounded();
        allow create: if teacher(sid) && productId.matches('^[A-Za-z0-9_-]{1,100}$') && financialProductShape() && request.resource.data.createdAt==request.time;
        allow update: if teacher(sid) && financialProductShape() && request.resource.data.createdAt==resource.data.createdAt;
        allow delete: if false;
      }
      function savingsPath(id) { return /databases/$(database)/documents/schools/$(sid)/savings/$(id); }
      function savingsShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','studentId','productId','productSnapshot','principalMinor','months','startAt','maturityAt','status','depositJournalId','maturityJournalId','interestMinor','schemaVersion','createdAt','updatedAt'])
          && d.keys().hasOnly(['schoolId','studentId','productId','productSnapshot','principalMinor','months','startAt','maturityAt','status','depositJournalId','maturityJournalId','interestMinor','schemaVersion','createdAt','updatedAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.studentId.matches('^[A-Za-z0-9_-]{1,100}$') && d.productId.matches('^[A-Za-z0-9_-]{1,100}$')
          && d.productSnapshot.keys().hasOnly(['name','rateBpsMonthly'])
          && d.productSnapshot.name is string && d.productSnapshot.rateBpsMonthly is int
          && d.principalMinor is int && d.principalMinor>=0
          && d.months is int && d.months>=1 && d.months<=120
          && d.startAt is string && d.maturityAt is string
          && d.status in ['active','matured']
          && d.depositJournalId is string
          && (d.maturityJournalId==null || d.maturityJournalId is string)
          && (d.interestMinor==null || (d.interestMinor is int && d.interestMinor>=0))
          && d.createdAt is timestamp && d.updatedAt==request.time;
      }
      // Savings enrollment is student self-service, trusted the same way PURCHASE is (D-23
      // precedent): amount/months are re-checked against the live product here, and the rate is
      // copied from the product doc, not the client, so it can't be forged. Interest itself is
      // never computed at enrollment — only at maturity, inside the teacher-session settlement
      // below — so this rule never needs to reimplement simpleInterest() in the rules language.
      match /savings/{contractId} {
        allow get: if teacher(sid) || ownStudent(sid,resource.data.studentId);
        allow list: if bounded() && (teacher(sid) || ownStudent(sid,resource.data.studentId));
        allow create: if activeStudent(sid) && callerStudentId(sid)==request.resource.data.studentId
          && contractId.matches('^[A-Za-z0-9_-]{1,100}$') && savingsShape()
          && request.resource.data.status=='active' && request.resource.data.maturityJournalId==null && request.resource.data.interestMinor==null
          && request.resource.data.createdAt==request.time
          && get(financialProductPath(request.resource.data.productId)).data.status=='active'
          && request.resource.data.principalMinor>=get(financialProductPath(request.resource.data.productId)).data.minMinor
          && request.resource.data.principalMinor<=get(financialProductPath(request.resource.data.productId)).data.maxMinor
          && request.resource.data.months>=get(financialProductPath(request.resource.data.productId)).data.minMonths
          && request.resource.data.months<=get(financialProductPath(request.resource.data.productId)).data.maxMonths
          && request.resource.data.productSnapshot.rateBpsMonthly==get(financialProductPath(request.resource.data.productId)).data.rateBpsMonthly
          && request.resource.data.depositJournalId==('savingsDeposit~'+contractId)
          && getAfter(journalPath(request.resource.data.depositJournalId)).data.type=='SAVINGS_DEPOSIT'
          && getAfter(journalPath(request.resource.data.depositJournalId)).data.amountMinor==request.resource.data.principalMinor
          && getAfter(journalPath(request.resource.data.depositJournalId)).data.debitAccountId==request.resource.data.studentId
          && getAfter(journalPath(request.resource.data.depositJournalId)).data.creditAccountId=='system-issuer';
        // Maturity settlement (teacher session): a one-way active->matured transition tied to an
        // INTEREST journal created in the same transaction. interestMinor is trusted from the
        // teacher's app-computed value the same way job.salaryMinor is trusted for SALARY — the
        // journal amount is still cross-checked against principal+interest so it can't drift.
        allow update: if teacher(sid) && savingsShape()
          && request.resource.data.studentId==resource.data.studentId && request.resource.data.productId==resource.data.productId
          && request.resource.data.productSnapshot==resource.data.productSnapshot
          && request.resource.data.principalMinor==resource.data.principalMinor && request.resource.data.months==resource.data.months
          && request.resource.data.startAt==resource.data.startAt && request.resource.data.maturityAt==resource.data.maturityAt
          && request.resource.data.depositJournalId==resource.data.depositJournalId && request.resource.data.createdAt==resource.data.createdAt
          && resource.data.status=='active' && request.resource.data.status=='matured'
          && request.resource.data.maturityJournalId==('interest~'+contractId)
          && getAfter(journalPath(request.resource.data.maturityJournalId)).data.type=='INTEREST'
          && getAfter(journalPath(request.resource.data.maturityJournalId)).data.amountMinor==request.resource.data.principalMinor+request.resource.data.interestMinor
          && getAfter(journalPath(request.resource.data.maturityJournalId)).data.debitAccountId=='system-issuer'
          && getAfter(journalPath(request.resource.data.maturityJournalId)).data.creditAccountId==resource.data.studentId;
        allow delete: if false;
      }
      function salaryJournalShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','type','jobId','studentId','period','debitAccountId','creditAccountId','amountMinor','postedBy','schemaVersion','createdAt'])
          && d.keys().hasOnly(['schoolId','type','jobId','studentId','period','debitAccountId','creditAccountId','amountMinor','postedBy','schemaVersion','createdAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.jobId.matches('^[A-Za-z0-9_-]{1,100}$') && d.studentId.matches('^[A-Za-z0-9_-]{1,100}$')
          && d.period.matches('^[0-9]{4}-[0-9]{2}$')
          && d.debitAccountId=='system-issuer' && d.creditAccountId==d.studentId
          && d.amountMinor is int && d.amountMinor>0 && d.amountMinor<=1000000
          && d.postedBy==request.auth.uid
          && d.createdAt==request.time;
      }
      function purchaseJournalShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','type','businessId','productId','buyerStudentId','debitAccountId','creditAccountId','amountMinor','postedBy','schemaVersion','createdAt'])
          && d.keys().hasOnly(['schoolId','type','businessId','productId','buyerStudentId','debitAccountId','creditAccountId','amountMinor','postedBy','schemaVersion','createdAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.businessId.matches('^[A-Za-z0-9_-]{1,100}$') && d.productId.matches('^[A-Za-z0-9_-]{1,100}$') && d.buyerStudentId.matches('^[A-Za-z0-9_-]{1,100}$')
          && d.debitAccountId==d.buyerStudentId && d.creditAccountId==d.businessId
          && d.amountMinor is int && d.amountMinor>0 && d.amountMinor<=100000
          && d.postedBy==d.buyerStudentId
          && d.createdAt==request.time;
      }
      // Shared by any journal that moves money between one student and the system-issuer with
      // only {studentId,contractId} as identifying context — SAVINGS_DEPOSIT and LOAN_REPAYMENT
      // (student pays in) both use studentToIssuerJournalShape; INTEREST and LOAN (issuer pays
      // out) both use issuerToStudentJournalShape. The caller still pins down the exact `type`
      // and which side is debit/credit via journalActorOk() and the per-type create clause below.
      function studentToIssuerJournalShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','type','studentId','contractId','debitAccountId','creditAccountId','amountMinor','postedBy','schemaVersion','createdAt'])
          && d.keys().hasOnly(['schoolId','type','studentId','contractId','debitAccountId','creditAccountId','amountMinor','postedBy','schemaVersion','createdAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.studentId.matches('^[A-Za-z0-9_-]{1,100}$') && d.contractId.matches('^[A-Za-z0-9_-]{1,100}$')
          && d.debitAccountId==d.studentId && d.creditAccountId=='system-issuer'
          && d.amountMinor is int && d.amountMinor>0 && d.amountMinor<=1000000000
          && d.postedBy==d.studentId && d.createdAt==request.time;
      }
      function issuerToStudentJournalShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','type','studentId','contractId','debitAccountId','creditAccountId','amountMinor','postedBy','schemaVersion','createdAt'])
          && d.keys().hasOnly(['schoolId','type','studentId','contractId','debitAccountId','creditAccountId','amountMinor','postedBy','schemaVersion','createdAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.studentId.matches('^[A-Za-z0-9_-]{1,100}$') && d.contractId.matches('^[A-Za-z0-9_-]{1,100}$')
          && d.debitAccountId=='system-issuer' && d.creditAccountId==d.studentId
          && d.amountMinor is int && d.amountMinor>0 && d.amountMinor<=1000000000
          && d.postedBy==request.auth.uid && d.createdAt==request.time;
      }
      // Income tax (§23): teacher-session settlement, one journal per student per period — not a
      // contract-scoped flow like savings/loans, so it keeps its own shape (period, not
      // contractId), mirroring salaryJournalShape rather than being folded into the issuer pair.
      function incomeTaxJournalShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','type','studentId','period','debitAccountId','creditAccountId','amountMinor','postedBy','schemaVersion','createdAt'])
          && d.keys().hasOnly(['schoolId','type','studentId','period','debitAccountId','creditAccountId','amountMinor','postedBy','schemaVersion','createdAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.studentId.matches('^[A-Za-z0-9_-]{1,100}$') && d.period.matches('^[0-9]{4}-[0-9]{2}$')
          && d.debitAccountId==d.studentId && d.creditAccountId=='community-fund'
          && d.amountMinor is int && d.amountMinor>0 && d.amountMinor<=1000000
          && d.postedBy==request.auth.uid && d.createdAt==request.time;
      }
      match /journals/{journalId} {
        allow get: if teacher(sid);
        allow list: if teacher(sid) && bounded();
        // Salary: the journal id itself is the idempotency key (a retried settlement targets
        // the same id, which already exists, so create is rejected — no operationKeys needed).
        // Purchase: a random client id is fine since repeat purchases are expected; every fact
        // about the sale (price, stock, business/product active, buyer's balance) is re-read
        // and re-checked here at creation time rather than trusted from the client.
        // Savings deposit: same self-service trust level as purchase (D-23) — id is derived from
        // the contract id so it lines up with the getAfter check in the savings create rule.
        // Interest: teacher-session settlement, id derived from contract id, the id itself being
        // the idempotency key so a retried maturity settlement can never double-pay (D-18 pattern).
        allow create: if
          (teacher(sid) && salaryJournalShape() && request.resource.data.type=='SALARY'
            && journalId==('salary~'+request.resource.data.jobId+'~'+request.resource.data.studentId+'~'+request.resource.data.period)
            && get(jobPath(request.resource.data.jobId)).data.salaryMinor==request.resource.data.amountMinor
            && get(assignmentPath(request.resource.data.jobId+'~'+request.resource.data.studentId)).data.status=='active'
            && get(/databases/$(database)/documents/schools/$(sid)/students/$(request.resource.data.studentId)).data.status=='active')
          ||
          (journalId.matches('^[A-Za-z0-9_-]{1,100}$') && purchaseJournalShape() && request.resource.data.type=='PURCHASE'
            && activeStudent(sid) && callerStudentId(sid)==request.resource.data.buyerStudentId
            && get(businessPath(request.resource.data.businessId)).data.status=='active'
            && get(productPath(request.resource.data.productId)).data.businessId==request.resource.data.businessId
            && get(productPath(request.resource.data.productId)).data.status=='active'
            && get(productPath(request.resource.data.productId)).data.stock>=1
            && get(productPath(request.resource.data.productId)).data.priceMinor==request.resource.data.amountMinor
            && get(/databases/$(database)/documents/schools/$(sid)/accounts/$(request.resource.data.buyerStudentId)).data.balanceMinor>=request.resource.data.amountMinor)
          ||
          (studentToIssuerJournalShape() && request.resource.data.type=='SAVINGS_DEPOSIT'
            && activeStudent(sid) && callerStudentId(sid)==request.resource.data.studentId
            && journalId==('savingsDeposit~'+request.resource.data.contractId)
            && get(/databases/$(database)/documents/schools/$(sid)/accounts/$(request.resource.data.studentId)).data.balanceMinor>=request.resource.data.amountMinor)
          ||
          (teacher(sid) && issuerToStudentJournalShape() && request.resource.data.type=='INTEREST'
            && journalId==('interest~'+request.resource.data.contractId)
            && get(savingsPath(request.resource.data.contractId)).data.studentId==request.resource.data.studentId
            && get(savingsPath(request.resource.data.contractId)).data.status=='active')
          ||
          // Loan disbursement: only as part of approving the matching financialRequests/{contractId}
          // (still 'reviewed' pre-transaction here, since the request's own update to 'approved'
          // happens in the same transaction) — amount must equal exactly what was requested.
          (teacher(sid) && issuerToStudentJournalShape() && request.resource.data.type=='LOAN'
            && journalId==('loan~'+request.resource.data.contractId)
            && get(financialRequestPath(request.resource.data.contractId)).data.status=='reviewed'
            && get(financialRequestPath(request.resource.data.contractId)).data.operation=='LOAN'
            && get(financialRequestPath(request.resource.data.contractId)).data.studentId==request.resource.data.studentId
            && get(financialRequestPath(request.resource.data.contractId)).data.principalMinor==request.resource.data.amountMinor)
          ||
          // Loan repayment: self-service full payoff, same trust tier as SAVINGS_DEPOSIT/PURCHASE —
          // amount must equal exactly the contract's outstanding total, not a client-chosen figure.
          (studentToIssuerJournalShape() && request.resource.data.type=='LOAN_REPAYMENT'
            && activeStudent(sid) && callerStudentId(sid)==request.resource.data.studentId
            && journalId==('loanRepayment~'+request.resource.data.contractId)
            && get(loanPath(request.resource.data.contractId)).data.studentId==request.resource.data.studentId
            && get(loanPath(request.resource.data.contractId)).data.status=='active'
            && get(loanPath(request.resource.data.contractId)).data.totalOwedMinor==request.resource.data.amountMinor
            && get(/databases/$(database)/documents/schools/$(sid)/accounts/$(request.resource.data.studentId)).data.balanceMinor>=request.resource.data.amountMinor)
          ||
          // Income tax: teacher-session settlement (like SALARY/INTEREST), amount trusted from
          // the app-computed preview (same tier as INTEREST — see D-51) rather than re-derived
          // from summing SALARY journals in Rules, which can't aggregate across documents. The
          // hard invariants Rules do enforce: target student is active, and the debit can never
          // drive their balance negative.
          (teacher(sid) && incomeTaxJournalShape() && request.resource.data.type=='INCOME_TAX'
            && journalId==('tax~'+request.resource.data.studentId+'~'+request.resource.data.period)
            && get(/databases/$(database)/documents/schools/$(sid)/students/$(request.resource.data.studentId)).data.status=='active'
            && get(/databases/$(database)/documents/schools/$(sid)/accounts/$(request.resource.data.studentId)).data.balanceMinor>=request.resource.data.amountMinor);
        allow update, delete: if false;
      }
      function financialRequestPath(id) { return /databases/$(database)/documents/schools/$(sid)/financialRequests/$(id); }
      function financeReviewPath(id) { return /databases/$(database)/documents/schools/$(sid)/financeReviews/$(id); }
      function loanPath(id) { return /databases/$(database)/documents/schools/$(sid)/loans/$(id); }
      function financialRequestShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','studentId','operation','productId','principalMinor','months','purpose','repaymentPlan','status','assignedStudentId','reviewNote','decisionNote','reviewerUid','createdEntityId','schemaVersion','createdAt','updatedAt'])
          && d.keys().hasOnly(['schoolId','studentId','operation','productId','principalMinor','months','purpose','repaymentPlan','status','assignedStudentId','reviewNote','decisionNote','reviewerUid','createdEntityId','schemaVersion','createdAt','updatedAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.studentId.matches('^[A-Za-z0-9_-]{1,100}$')
          && d.operation=='LOAN'
          && d.productId.matches('^[A-Za-z0-9_-]{1,100}$')
          && d.principalMinor is int && d.principalMinor>=0
          && d.months is int && d.months>=1 && d.months<=120
          && d.purpose is string && d.purpose.size()>0 && d.purpose.size()<=500
          && d.repaymentPlan is string && d.repaymentPlan.size()>0 && d.repaymentPlan.size()<=500
          && d.status in ['submitted','assigned','reviewed','approved','rejected']
          && (d.assignedStudentId==null || d.assignedStudentId is string)
          && d.reviewNote is string && d.reviewNote.size()<=500
          && d.decisionNote is string && d.decisionNote.size()<=500
          && (d.reviewerUid==null || d.reviewerUid is string)
          && (d.createdEntityId==null || d.createdEntityId is string)
          && d.createdAt is timestamp && d.updatedAt==request.time;
      }
      function financialRequestUnchangedCore() {
        return request.resource.data.studentId==resource.data.studentId
          && request.resource.data.operation==resource.data.operation
          && request.resource.data.productId==resource.data.productId
          && request.resource.data.principalMinor==resource.data.principalMinor
          && request.resource.data.months==resource.data.months
          && request.resource.data.purpose==resource.data.purpose
          && request.resource.data.repaymentPlan==resource.data.repaymentPlan
          && request.resource.data.createdAt==resource.data.createdAt;
      }
      // Status machine mirrors proposals (submitted->voting->closed->approved/rejected): a
      // student submits, and every forward transition is teacher- or assigned-reviewer-gated.
      // submitted -> assigned (teacher picks a reviewer, any active student — not required to
      // hold a "banker" job; see docs/DECISIONS.md D-52) -> reviewed (the assigned reviewer
      // submits a financeReviews checklist, tied via getAfter — D-26 pattern) -> approved (teacher,
      // disburses via the LOAN journal clause above) / rejected (teacher, from any pre-decision
      // state, so an obviously invalid request doesn't have to wait for a wasted review).
      match /financialRequests/{requestId} {
        allow get: if teacher(sid) || ownStudent(sid,resource.data.studentId) || (activeStudent(sid) && callerStudentId(sid)==resource.data.assignedStudentId);
        allow list: if bounded() && (teacher(sid) || ownStudent(sid,resource.data.studentId) || (activeStudent(sid) && callerStudentId(sid)==resource.data.assignedStudentId));
        allow create: if ownStudent(sid,request.resource.data.studentId) && financialRequestShape()
          && request.resource.data.status=='submitted' && request.resource.data.assignedStudentId==null
          && request.resource.data.reviewNote=='' && request.resource.data.decisionNote==''
          && request.resource.data.reviewerUid==null && request.resource.data.createdEntityId==null
          && request.resource.data.createdAt==request.time
          && get(financialProductPath(request.resource.data.productId)).data.status=='active'
          && get(financialProductPath(request.resource.data.productId)).data.kind=='loan'
          && request.resource.data.principalMinor>=get(financialProductPath(request.resource.data.productId)).data.minMinor
          && request.resource.data.principalMinor<=get(financialProductPath(request.resource.data.productId)).data.maxMinor
          && request.resource.data.months>=get(financialProductPath(request.resource.data.productId)).data.minMonths
          && request.resource.data.months<=get(financialProductPath(request.resource.data.productId)).data.maxMonths;
        allow update: if financialRequestShape() && financialRequestUnchangedCore()
          && (
            (teacher(sid) && resource.data.status=='submitted' && request.resource.data.status=='assigned'
              && request.resource.data.assignedStudentId is string
              && get(/databases/$(database)/documents/schools/$(sid)/students/$(request.resource.data.assignedStudentId)).data.status=='active'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','assignedStudentId','updatedAt']))
            ||
            (activeStudent(sid) && callerStudentId(sid)==resource.data.assignedStudentId
              && resource.data.status=='assigned' && request.resource.data.status=='reviewed'
              && request.resource.data.assignedStudentId==resource.data.assignedStudentId
              && getAfter(financeReviewPath(requestId)).data.assignedStudentId==callerStudentId(sid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewNote','updatedAt']))
            ||
            (teacher(sid) && resource.data.status in ['submitted','assigned','reviewed'] && request.resource.data.status=='rejected'
              && request.resource.data.decisionNote.size()>0 && request.resource.data.reviewerUid==request.auth.uid
              && request.resource.data.createdEntityId==null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decisionNote','reviewerUid','createdEntityId','updatedAt']))
            ||
            (teacher(sid) && resource.data.status=='reviewed' && request.resource.data.status=='approved'
              && request.resource.data.reviewerUid==request.auth.uid
              && request.resource.data.createdEntityId==requestId
              && getAfter(loanPath(requestId)).data.studentId==resource.data.studentId
              && getAfter(journalPath('loan~'+requestId)).data.type=='LOAN'
              && getAfter(journalPath('loan~'+requestId)).data.amountMinor==resource.data.principalMinor
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decisionNote','reviewerUid','createdEntityId','updatedAt']))
          );
        allow delete: if false;
      }
      function financeReviewShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','requestId','assignedStudentId','checklist','note','schemaVersion','createdAt'])
          && d.keys().hasOnly(['schoolId','requestId','assignedStudentId','checklist','note','schemaVersion','createdAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.requestId.matches('^[A-Za-z0-9_-]{1,100}$')
          && d.assignedStudentId.matches('^[A-Za-z0-9_-]{1,100}$')
          && d.checklist.keys().hasOnly(['studentActiveConfirmed','amountReasonable','noDuplicateLoan'])
          && d.checklist.studentActiveConfirmed is bool && d.checklist.amountReasonable is bool && d.checklist.noDuplicateLoan is bool
          && d.note is string && d.note.size()<=500
          && d.createdAt==request.time;
      }
      // One checklist per request (doc id == requestId), visible only to the teacher and the
      // reviewer themself — the applicant sees only the final decisionNote on their own request,
      // matching §6's minimum-exposure principle for financial information.
      match /financeReviews/{requestId} {
        allow get: if teacher(sid) || (activeStudent(sid) && callerStudentId(sid)==resource.data.assignedStudentId);
        allow list: if bounded() && (teacher(sid) || (activeStudent(sid) && callerStudentId(sid)==resource.data.assignedStudentId));
        allow create: if activeStudent(sid) && callerStudentId(sid)==request.resource.data.assignedStudentId
          && requestId==request.resource.data.requestId && financeReviewShape()
          && get(financialRequestPath(requestId)).data.status=='assigned'
          && get(financialRequestPath(requestId)).data.assignedStudentId==callerStudentId(sid);
        allow update, delete: if false;
      }
      function loanShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','studentId','productId','productSnapshot','principalMinor','months','interestMinor','totalOwedMinor','repaidMinor','status','disbursementJournalId','repaymentJournalId','startAt','dueAt','schemaVersion','createdAt','updatedAt'])
          && d.keys().hasOnly(['schoolId','studentId','productId','productSnapshot','principalMinor','months','interestMinor','totalOwedMinor','repaidMinor','status','disbursementJournalId','repaymentJournalId','startAt','dueAt','schemaVersion','createdAt','updatedAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.studentId.matches('^[A-Za-z0-9_-]{1,100}$') && d.productId.matches('^[A-Za-z0-9_-]{1,100}$')
          && d.productSnapshot.keys().hasOnly(['name','rateBpsMonthly'])
          && d.productSnapshot.name is string && d.productSnapshot.rateBpsMonthly is int
          && d.principalMinor is int && d.principalMinor>=0
          && d.months is int && d.months>=1 && d.months<=120
          && d.interestMinor is int && d.interestMinor>=0
          && d.totalOwedMinor is int && d.totalOwedMinor==d.principalMinor+d.interestMinor
          && d.repaidMinor is int && d.repaidMinor>=0
          && d.status in ['active','repaid']
          && d.disbursementJournalId is string
          && (d.repaymentJournalId==null || d.repaymentJournalId is string)
          && d.startAt is string && d.dueAt is string
          && d.createdAt is timestamp && d.updatedAt==request.time;
      }
      // Doc id == the approved financialRequests id, so a loan contract is always the unique
      // product of exactly one approval (D-30-style deterministic id, re-used here).
      match /loans/{contractId} {
        allow get: if teacher(sid) || ownStudent(sid,resource.data.studentId);
        allow list: if bounded() && (teacher(sid) || ownStudent(sid,resource.data.studentId));
        allow create: if teacher(sid) && contractId.matches('^[A-Za-z0-9_-]{1,100}$') && loanShape()
          && request.resource.data.status=='active' && request.resource.data.repaidMinor==0 && request.resource.data.repaymentJournalId==null
          && request.resource.data.createdAt==request.time
          && request.resource.data.disbursementJournalId==('loan~'+contractId)
          && getAfter(journalPath(request.resource.data.disbursementJournalId)).data.type=='LOAN'
          && getAfter(journalPath(request.resource.data.disbursementJournalId)).data.studentId==request.resource.data.studentId
          && getAfter(journalPath(request.resource.data.disbursementJournalId)).data.amountMinor==request.resource.data.principalMinor
          && get(financialRequestPath(contractId)).data.status=='reviewed'
          && get(financialRequestPath(contractId)).data.studentId==request.resource.data.studentId
          && get(financialRequestPath(contractId)).data.productId==request.resource.data.productId;
        // Repayment: the owning student only, active->repaid once, full payoff only (no partial
        // repayment yet — docs/DECISIONS.md D-52), tied to a LOAN_REPAYMENT journal in the same tx.
        allow update: if ownStudent(sid,resource.data.studentId) && loanShape()
          && request.resource.data.studentId==resource.data.studentId && request.resource.data.productId==resource.data.productId
          && request.resource.data.productSnapshot==resource.data.productSnapshot
          && request.resource.data.principalMinor==resource.data.principalMinor && request.resource.data.months==resource.data.months
          && request.resource.data.interestMinor==resource.data.interestMinor && request.resource.data.totalOwedMinor==resource.data.totalOwedMinor
          && request.resource.data.disbursementJournalId==resource.data.disbursementJournalId
          && request.resource.data.startAt==resource.data.startAt && request.resource.data.dueAt==resource.data.dueAt
          && request.resource.data.createdAt==resource.data.createdAt
          && resource.data.status=='active' && request.resource.data.status=='repaid'
          && request.resource.data.repaidMinor==request.resource.data.totalOwedMinor
          && request.resource.data.repaymentJournalId==('loanRepayment~'+contractId)
          && getAfter(journalPath(request.resource.data.repaymentJournalId)).data.type=='LOAN_REPAYMENT'
          && getAfter(journalPath(request.resource.data.repaymentJournalId)).data.amountMinor==request.resource.data.totalOwedMinor
          && getAfter(journalPath(request.resource.data.repaymentJournalId)).data.debitAccountId==resource.data.studentId
          && getAfter(journalPath(request.resource.data.repaymentJournalId)).data.creditAccountId=='system-issuer';
        allow delete: if false;
      }
      function jobFieldsShape(f) {
        return f.keys().hasAll(['title','purpose','tasks','beneficiary','suggestedSalaryMinor','tools','reason'])
          && f.keys().hasOnly(['title','purpose','tasks','beneficiary','suggestedSalaryMinor','tools','reason'])
          && f.title is string && f.title.size()>0 && f.title.size()<=60
          && f.purpose is string && f.purpose.size()>0 && f.purpose.size()<=1000
          && f.tasks is string && f.tasks.size()>0 && f.tasks.size()<=1000
          && f.beneficiary is string && f.beneficiary.size()<=500
          && f.suggestedSalaryMinor is int && f.suggestedSalaryMinor>=0 && f.suggestedSalaryMinor<=1000000
          && f.tools is string && f.tools.size()<=500
          && f.reason is string && f.reason.size()>0 && f.reason.size()<=1000;
      }
      function businessFieldsShape(f) {
        return f.keys().hasAll(['name','product','customers','price','capital','staffNeeded','expectedRevenue','expectedCost','advantages','risks'])
          && f.keys().hasOnly(['name','product','customers','price','capital','staffNeeded','expectedRevenue','expectedCost','advantages','risks'])
          && f.name is string && f.name.size()>0 && f.name.size()<=60
          && f.product is string && f.product.size()>0 && f.product.size()<=500
          && f.customers is string && f.customers.size()<=500
          && f.price is string && f.price.size()<=200
          && f.capital is string && f.capital.size()<=200
          && f.staffNeeded is string && f.staffNeeded.size()<=200
          && f.expectedRevenue is string && f.expectedRevenue.size()<=500
          && f.expectedCost is string && f.expectedCost.size()<=500
          && f.advantages is string && f.advantages.size()<=1000
          && f.risks is string && f.risks.size()<=1000;
      }
      function proposalFieldsShape(type,fields) {
        return (type=='job' && jobFieldsShape(fields)) || (type=='business' && businessFieldsShape(fields));
      }
      function proposalShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','type','authorStudentId','fields','status','deadlineAt','minParticipation','approvalThreshold','tallyYes','tallyNo','tallyTotal','decisionNote','reviewerUid','createdEntityId','schemaVersion','createdAt','updatedAt'])
          && d.keys().hasOnly(['schoolId','type','authorStudentId','fields','status','deadlineAt','minParticipation','approvalThreshold','tallyYes','tallyNo','tallyTotal','decisionNote','reviewerUid','createdEntityId','schemaVersion','createdAt','updatedAt'])
          && d.schoolId==sid && d.schemaVersion==1
          && d.type in ['job','business']
          && d.authorStudentId.matches('^[A-Za-z0-9_-]{1,100}$')
          && proposalFieldsShape(d.type,d.fields)
          && d.status in ['submitted','voting','closed','approved','rejected']
          && d.minParticipation is int && d.minParticipation>=0 && d.minParticipation<=100
          && d.approvalThreshold is int && d.approvalThreshold>=0 && d.approvalThreshold<=100
          && d.tallyYes is int && d.tallyYes>=0 && d.tallyNo is int && d.tallyNo>=0 && d.tallyTotal is int && d.tallyTotal>=0
          && (d.deadlineAt==null || d.deadlineAt is timestamp)
          && d.decisionNote is string && d.decisionNote.size()<=500
          && (d.reviewerUid==null || d.reviewerUid is string)
          && (d.createdEntityId==null || d.createdEntityId is string)
          && d.createdAt is timestamp && d.updatedAt==request.time;
      }
      function proposalUnchangedCore() {
        return request.resource.data.type==resource.data.type
          && request.resource.data.authorStudentId==resource.data.authorStudentId
          && request.resource.data.fields==resource.data.fields
          && request.resource.data.createdAt==resource.data.createdAt;
      }
      // Students submit job/business proposals with structured fields (never one free-text
      // box — see D-27). Voting policy is teacher-set only when opening the vote, not at
      // submission. A closed proposal's tally is teacher-computed from the votes subcollection
      // (Rules cannot aggregate a subcollection) and trusted the same way other teacher-entered
      // figures are; the vote documents themselves stay tamper-evident and one-per-account.
      match /proposals/{proposalId} {
        allow get: if active(sid);
        allow list: if active(sid) && bounded();
        allow create: if ownStudent(sid,request.resource.data.authorStudentId) && proposalShape()
          && request.resource.data.status=='submitted'
          && request.resource.data.deadlineAt==null
          && request.resource.data.minParticipation==0 && request.resource.data.approvalThreshold==50
          && request.resource.data.tallyYes==0 && request.resource.data.tallyNo==0 && request.resource.data.tallyTotal==0
          && request.resource.data.decisionNote=='' && request.resource.data.reviewerUid==null && request.resource.data.createdEntityId==null
          && request.resource.data.createdAt==request.time;
        allow update: if proposalShape() && proposalUnchangedCore()
          && (
            (teacher(sid) && resource.data.status=='submitted' && request.resource.data.status=='voting'
              && request.resource.data.deadlineAt is timestamp && request.resource.data.deadlineAt>request.time
              && request.resource.data.tallyYes==0 && request.resource.data.tallyNo==0 && request.resource.data.tallyTotal==0
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','deadlineAt','minParticipation','approvalThreshold','updatedAt']))
            ||
            (teacher(sid) && resource.data.status=='voting' && request.resource.data.status=='closed'
              && request.time>=resource.data.deadlineAt
              && request.resource.data.tallyTotal==request.resource.data.tallyYes+request.resource.data.tallyNo
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','tallyYes','tallyNo','tallyTotal','updatedAt']))
            ||
            (teacher(sid) && resource.data.status=='closed' && request.resource.data.status in ['approved','rejected']
              && request.resource.data.reviewerUid==request.auth.uid
              && (request.resource.data.status=='approved' || request.resource.data.decisionNote.size()>0)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decisionNote','reviewerUid','createdEntityId','updatedAt'])
              && (
                (request.resource.data.status=='rejected' && request.resource.data.createdEntityId==null)
                ||
                (request.resource.data.status=='approved' && request.resource.data.createdEntityId==('proposal-'+proposalId)
                  && (
                    (resource.data.type=='job' && getAfter(jobPath('proposal-'+proposalId)).data.schoolId==sid)
                    ||
                    (resource.data.type=='business' && getAfter(businessPath('proposal-'+proposalId)).data.schoolId==sid
                      && getAfter(accountPath('proposal-'+proposalId)).data.ownerType=='business')
                  ))
              ))
          );
        allow delete: if false;
        match /votes/{uid} {
          allow get: if teacher(sid) || request.auth.uid==uid;
          allow list: if teacher(sid) && boundedVotes();
          allow create: if activeStudent(sid) && request.auth.uid==uid
            && request.resource.data.keys().hasAll(['choice','createdAt']) && request.resource.data.keys().hasOnly(['choice','createdAt'])
            && request.resource.data.choice in ['yes','no'] && request.resource.data.createdAt==request.time
            && get(/databases/$(database)/documents/schools/$(sid)/proposals/$(proposalId)).data.status=='voting'
            && request.time<get(/databases/$(database)/documents/schools/$(sid)/proposals/$(proposalId)).data.deadlineAt;
          allow update, delete: if false;
        }
      }
      function auditLogShape() {
        let d=request.resource.data;
        return d.keys().hasAll(['schoolId','actorUid','action','targetType','targetId','detail','createdAt'])
          && d.keys().hasOnly(['schoolId','actorUid','action','targetType','targetId','detail','createdAt'])
          && d.schoolId==sid && d.actorUid==request.auth.uid
          && d.action is string && d.action.size()>0 && d.action.size()<=60
          && d.targetType is string && d.targetType.size()<=60
          && d.targetId is string && d.targetId.size()<=200
          && d.detail is string && d.detail.size()<=500
          && d.createdAt==request.time;
      }
      // Append-only trail of sensitive teacher actions (§62): who, when, what, on which target.
      // Never readable by students, never editable by anyone — a correction is a new proposal
      // decision or a new journal, not a rewritten log line.
      match /auditLogs/{logId} {
        allow get: if teacher(sid);
        allow list: if teacher(sid) && bounded();
        allow create: if teacher(sid) && auditLogShape();
        allow update, delete: if false;
      }
      // Each future feature receives explicit rules and emulator tests before activation.
      match /{document=**} { allow read, write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
